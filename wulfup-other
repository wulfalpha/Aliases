#!/usr/bin/env bash

# wulfup-other - Additional update commands for non-pacman packages
# This script is called by wulfup when --other-updates is used

set -euo pipefail

# Color definitions (matching main wulfup script)
if [[ -t 2 ]]; then
    GREEN='\e[0;32m'
    BLUE='\e[0;34m'
    YELLOW='\e[0;33m'
    RED='\e[0;31m'
    BOLD='\e[1m'
    RESET='\e[0m'
else
    GREEN='' BLUE='' YELLOW='' RED='' BOLD='' RESET=''
fi

# Output functions
info() {
    echo -e "${BLUE}${BOLD}==>${RESET} ${BOLD}$*${RESET}" >&2
}

success() {
    echo -e "${GREEN}${BOLD}==>${RESET} ${GREEN}$*${RESET}" >&2
}

warn() {
    echo -e "${YELLOW}${BOLD}==> WARNING:${RESET} ${YELLOW}$*${RESET}" >&2
}

error() {
    echo -e "${RED}${BOLD}==> ERROR:${RESET} ${RED}$*${RESET}" >&2
}

step() {
    echo -e "${BLUE}${BOLD}::${RESET} $*" >&2
}

# Show command before running (transparent execution)
run_cmd() {
    echo -e "${GREEN}${BOLD}\$${RESET} $*" >&2
    "$@"
}

run_sudo() {
    echo -e "${GREEN}${BOLD}\$ sudo${RESET} $*" >&2
    sudo "$@"
}

#==============================================================================
# Update Functions
#==============================================================================

update_flatpak() {
    if ! command -v flatpak &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating Flatpak applications..."

    # Check if any flatpaks are installed
    if [[ $(flatpak list 2>/dev/null | wc -l) -eq 0 ]]; then
        info "No Flatpak applications installed, skipping"
        return 0
    fi

    run_cmd flatpak update -y || warn "Flatpak update failed"
}

update_snap() {
    if ! command -v snap &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating Snap packages..."

    # Check if any snaps are installed
    if [[ $(snap list 2>/dev/null | wc -l) -le 1 ]]; then
        info "No Snap packages installed, skipping"
        return 0
    fi

    run_cmd sudo snap refresh || warn "Snap refresh failed"
}

update_doom_emacs() {
    if ! command -v doom &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating Doom Emacs..."
    run_cmd doom upgrade || warn "Doom Emacs update failed"
}

update_rust() {
    if ! command -v rustup &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating Rust toolchain..."
    run_cmd rustup update || warn "Rust update failed"
}

update_npm_globals() {
    if ! command -v npm &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating global npm packages..."

    # Check if any global packages are installed
    local global_packages
    global_packages=$(npm list -g --depth=0 2>/dev/null | wc -l)

    if [[ $global_packages -le 1 ]]; then
        info "No global npm packages installed, skipping"
        return 0
    fi

    run_sudo npm update -g || warn "npm global update failed"
}

update_pipx() {
    if ! command -v pipx &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    step "Updating pipx packages..."

    # Check if any pipx packages are installed
    if [[ $(pipx list 2>/dev/null | grep -c "package") -eq 0 ]]; then
        info "No pipx packages installed, skipping"
        return 0
    fi

    run_cmd pipx upgrade-all || warn "pipx upgrade failed"
}

update_cargo_packages() {
    if ! command -v cargo &>/dev/null || ! command -v cargo-install-update &>/dev/null; then
        return 0  # Silently skip if cargo or cargo-update not installed
    fi

    step "Updating cargo-installed packages..."
    run_cmd cargo install-update -a || warn "cargo update failed"
}

update_go_packages() {
    if ! command -v go &>/dev/null; then
        return 0  # Silently skip if not installed
    fi

    # Only if you use a tool like gup or have a list of go packages
    # This is just a placeholder - customize as needed
    if command -v gup &>/dev/null; then
        step "Updating Go packages..."
        run_cmd gup update || warn "Go package update failed"
    fi
}

# Add more update functions here as needed
#==============================================================================
# Main execution
#==============================================================================

main() {
    info "Running additional package updates..."
    echo

    # Call update functions - only runs if the tool is installed
    update_flatpak
    update_snap
    update_doom_emacs
    update_rust
    update_npm_globals
    update_pipx
    update_cargo_packages
    update_go_packages

    # Uncomment or add more as needed:
    # update_rust
    # update_npm_globals
    # update_pipx

    echo
    success "Additional updates complete"
}

main "$@"
