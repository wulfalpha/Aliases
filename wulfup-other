#!/usr/bin/env bash

# wulfup-other - Additional update commands for non-pacman packages
# This script is called by wulfup when --other is used

set -euo pipefail

if [[ -z "${WULFUP_LOGGED:-}" ]]; then
    LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wulfup"
    mkdir -p "$LOG_DIR"
    LOG_FILE="$LOG_DIR/$(basename "$0")-$(date +%Y%m%d-%H%M%S).log"
    export WULFUP_LOGGED=1
    if [[ "$(uname -s)" == "Darwin" ]]; then
        exec script -q "$LOG_FILE" "$0" "$@"
    else
        printf -v _wulfup_cmd '%q ' "$0" "$@"
        exec script -qc "$_wulfup_cmd" "$LOG_FILE"
    fi
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _wulfup_lib in "${SCRIPT_DIR}/wulfup-lib.sh" "/usr/lib/wulfup/wulfup-lib.sh"; do
    if [[ -f "$_wulfup_lib" ]]; then
        # shellcheck source=/dev/null
        source "$_wulfup_lib"
        break
    fi
done
unset _wulfup_lib
[[ -n "${WULFUP_LIB_LOADED:-}" ]] || { echo "wulfup-lib.sh not found" >&2; exit 1; }

# Updater toggles (override in ~/.config/wulfup/config)
WULFUP_OTHER_HBLOCK="${WULFUP_OTHER_HBLOCK:-yes}"
WULFUP_OTHER_FLATPAK="${WULFUP_OTHER_FLATPAK:-yes}"
WULFUP_OTHER_SNAP="${WULFUP_OTHER_SNAP:-yes}"
WULFUP_OTHER_DOOM="${WULFUP_OTHER_DOOM:-yes}"
WULFUP_OTHER_LAZY_NVIM="${WULFUP_OTHER_LAZY_NVIM:-yes}"
WULFUP_OTHER_RUST="${WULFUP_OTHER_RUST:-yes}"
WULFUP_OTHER_NPM="${WULFUP_OTHER_NPM:-yes}"
WULFUP_OTHER_PIPX="${WULFUP_OTHER_PIPX:-yes}"
WULFUP_OTHER_YAZI="${WULFUP_OTHER_YAZI:-yes}"
WULFUP_OTHER_CARGO="${WULFUP_OTHER_CARGO:-yes}"
WULFUP_OTHER_GO="${WULFUP_OTHER_GO:-yes}"
WULFUP_OTHER_TLDR="${WULFUP_OTHER_TLDR:-yes}"
WULFUP_OTHER_ANTIBODY="${WULFUP_OTHER_ANTIBODY:-yes}"
WULFUP_OTHER_TMUX="${WULFUP_OTHER_TMUX:-yes}"
WULFUP_OTHER_PACSTALL="${WULFUP_OTHER_PACSTALL:-yes}"
WULFUP_OTHER_APPIMAGE="${WULFUP_OTHER_APPIMAGE:-yes}"

run_updater() {
    local name="$1"
    shift

    if "$@"; then
        return 0
    fi

    handle_failure "$name"
}

#==============================================================================
# Update Functions
#==============================================================================

update_hblock() {
    [[ "$WULFUP_OTHER_HBLOCK" == "yes" ]] || return 0

    if ! command -v hblock &>/dev/null; then
        return 0
    fi

    step "Updating hblock hosts file..."
    run_sudo hblock
}

update_flatpak() {
    [[ "$WULFUP_OTHER_FLATPAK" == "yes" ]] || return 0

    if ! command -v flatpak &>/dev/null; then
        return 0
    fi

    step "Updating Flatpak applications..."

    if [[ $(flatpak list 2>/dev/null | wc -l) -eq 0 ]]; then
        info "No Flatpak applications installed, skipping"
        return 0
    fi

    run_cmd flatpak update -y
}

update_snap() {
    [[ "$WULFUP_OTHER_SNAP" == "yes" ]] || return 0

    if ! command -v snap &>/dev/null; then
        return 0
    fi

    step "Updating Snap packages..."

    if [[ $(snap list 2>/dev/null | wc -l) -le 1 ]]; then
        info "No Snap packages installed, skipping"
        return 0
    fi

    run_sudo snap refresh
}

update_pacstall() {
    [[ "$WULFUP_OTHER_PACSTALL" == "yes" ]] || return 0

    if ! command -v pacstall &>/dev/null; then
        return 0
    fi

    step "Updating Pacstall packages..."
    run_cmd pacstall -Up
    run_cmd pacstall -U
}

update_appimage() {
    [[ "$WULFUP_OTHER_APPIMAGE" == "yes" ]] || return 0

    if ! command -v appimageupdatetool &>/dev/null; then
        return 0
    fi

    local appimage_dir="$HOME/Applications"
    if [[ ! -d "$appimage_dir" ]]; then
        return 0
    fi

    step "Checking for AppImage updates..."

    local found=0
    while IFS= read -r -d '' appimage; do
        found=1
        info "Updating $(basename "$appimage")..."
        run_cmd appimageupdatetool "$appimage"
    done < <(find "$appimage_dir" -name '*.AppImage' -print0 2>/dev/null)

    if [[ $found -eq 0 ]]; then
        info "No AppImages found in $appimage_dir"
    fi
}

update_doom_emacs() {
    [[ "$WULFUP_OTHER_DOOM" == "yes" ]] || return 0

    if ! command -v doom &>/dev/null; then
        return 0
    fi

    step "Updating Doom Emacs..."
    # `doom up` fetches from upstream git and intermittently fails with
    # "Failed to fetch from upstream"; a short backoff clears most of them.
    local attempt
    for attempt in 1 2 3; do
        run_cmd doom up && break
        if [[ $attempt -eq 3 ]]; then
            handle_failure "Doom Emacs upgrade (doom up)"
            return
        fi
        warn "doom up failed (attempt $attempt/3), retrying in 5s..."
        sleep 5
    done

    step "Syncing Doom Emacs and updating packages..."
    run_cmd doom sync -u
}

update_lazy_nvim() {
    [[ "$WULFUP_OTHER_LAZY_NVIM" == "yes" ]] || return 0

    if ! command -v nvim &>/dev/null; then
        return 0
    fi

    local lazy_lock="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lazy-lock.json"
    if [[ ! -f "$lazy_lock" ]]; then
        return 0
    fi

    step "Updating Neovim plugins via lazy.nvim..."
    run_cmd nvim --headless "+Lazy! sync" +qa
}

update_rust() {
    [[ "$WULFUP_OTHER_RUST" == "yes" ]] || return 0

    if ! command -v rustup &>/dev/null; then
        return 0
    fi

    step "Updating Rust toolchain..."
    run_cmd rustup update
}

update_npm_globals() {
    [[ "$WULFUP_OTHER_NPM" == "yes" ]] || return 0

    if ! command -v npm &>/dev/null; then
        return 0
    fi

    # Resolve where npm actually writes globals. This is $prefix/lib/node_modules,
    # not $prefix -- testing $prefix for writability gives false positives.
    local npm_root
    npm_root=$(npm root -g 2>/dev/null) || npm_root=""
    [[ -n "$npm_root" ]] || return 0

    # Don't fight a package manager over its own tree. Homebrew's node
    # post_install deletes and re-copies $BREW_PREFIX/lib/node_modules/npm on
    # every upgrade, and /usr belongs to pacman/apt.
    local brew_prefix=""
    if command -v brew &>/dev/null; then
        brew_prefix=$(brew --prefix 2>/dev/null) || brew_prefix=""
    fi
    if [[ -n "$brew_prefix" && "$npm_root" == "$brew_prefix"/* ]]; then
        info "npm globals live under Homebrew ($npm_root), leaving them to brew"
        return 0
    fi
    if [[ "$npm_root" == /usr/* ]]; then
        info "npm globals live under $npm_root (system-managed), skipping"
        return 0
    fi

    if [[ ! -w "$npm_root" ]]; then
        warn "npm global root not writable: $npm_root"
        warn "Fix ownership instead of using sudo: chown -R \"\$(id -un)\" $npm_root"
        return 1
    fi

    # Count real globals, ignoring the tree root line and npm itself.
    local count
    count=$(npm ls -g --depth=0 --parseable 2>/dev/null \
        | tail -n +2 | grep -vc '/node_modules/npm$') || count=0

    if [[ "$count" -eq 0 ]]; then
        info "No user-installed global npm packages, skipping"
        return 0
    fi

    step "Updating global npm packages..."
    run_cmd npm update -g
}

update_pipx() {
    [[ "$WULFUP_OTHER_PIPX" == "yes" ]] || return 0

    if ! command -v pipx &>/dev/null; then
        return 0
    fi

    step "Updating pipx packages..."

    if [[ $(pipx list 2>/dev/null | grep -c "package") -eq 0 ]]; then
        info "No pipx packages installed, skipping"
        return 0
    fi

    run_cmd pipx upgrade-all
}

update_cargo_packages() {
    [[ "$WULFUP_OTHER_CARGO" == "yes" ]] || return 0

    if ! command -v cargo &>/dev/null || ! command -v cargo-install-update &>/dev/null; then
        return 0
    fi

    step "Updating cargo-installed packages..."
    run_cmd cargo install-update -a
}

update_go_packages() {
    [[ "$WULFUP_OTHER_GO" == "yes" ]] || return 0

    if ! command -v go &>/dev/null; then
        return 0
    fi

    if command -v gup &>/dev/null; then
        step "Updating Go packages..."
        run_cmd gup update
    fi
}

update_tldr() {
    [[ "$WULFUP_OTHER_TLDR" == "yes" ]] || return 0

    if ! command -v tldr &>/dev/null; then
        return 0
    fi

    step "Updating tldr cache..."
    run_cmd tldr --update
}

update_antibody() {
    [[ "$WULFUP_OTHER_ANTIBODY" == "yes" ]] || return 0

    if ! command -v antibody &>/dev/null; then
        return 0
    fi

    if [[ -f "$HOME/.zsh_plugins.txt" ]]; then
        step "Updating antibody plugins..."
        run_cmd antibody update
    fi
}

update_tmux_plugins() {
    [[ "$WULFUP_OTHER_TMUX" == "yes" ]] || return 0

    if ! command -v tmux &>/dev/null; then
        return 0
    fi

    local tpm_path="$HOME/.tmux/plugins/tpm"
    if [[ -d "$tpm_path" ]]; then
        step "Updating tmux plugins..."
        run_cmd "$tpm_path/bin/update_plugins" all
    fi
}

update_yazi_plugins() {
    [[ "$WULFUP_OTHER_YAZI" == "yes" ]] || return 0

    if ! command -v ya &>/dev/null; then
        return 0
    fi

    step "Updating yazi plugins..."
    run_cmd ya pkg upgrade
}

#==============================================================================
# Main execution
#==============================================================================

main() {
    load_config

    info "Running additional package updates..."
    echo

    run_updater "hblock" update_hblock
    run_updater "flatpak" update_flatpak
    run_updater "snap" update_snap
    run_updater "pacstall" update_pacstall
    run_updater "appimage" update_appimage
    run_updater "doom-emacs" update_doom_emacs
    run_updater "lazy.nvim" update_lazy_nvim
    run_updater "rust" update_rust
    run_updater "npm" update_npm_globals
    run_updater "pipx" update_pipx
    run_updater "yazi" update_yazi_plugins
    run_updater "cargo" update_cargo_packages
    run_updater "go" update_go_packages
    run_updater "tldr" update_tldr
    run_updater "antibody" update_antibody
    run_updater "tmux" update_tmux_plugins

    echo
    if report_failures; then
        success "Additional updates complete"
    else
        die "$WULFUP_EXIT_ERROR" "Additional updates finished with errors"
    fi
}

main "$@"