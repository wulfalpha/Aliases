#!/usr/bin/env bash

# wulfup - A transparent system updater for Arch Linux and macOS
# Handles keyrings, lock files, AUR helpers, homebrew, and package maintenance

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _wulfup_lib in "${SCRIPT_DIR}/wulfup-lib.sh" "/usr/lib/wulfup/wulfup-lib.sh"; do
    if [[ -f "$_wulfup_lib" ]]; then
        # shellcheck source=/dev/null
        source "$_wulfup_lib"
        break
    fi
done
unset _wulfup_lib
[[ -n "${WULFUP_LIB_LOADED:-}" ]] || { echo "wulfup-lib.sh not found" >&2; exit 1; }

progname="${0##*/}"
VERSION="1.3.0"

# Platform detection
PLATFORM=""
if [[ "$(uname -s)" == "Darwin" ]]; then
    PLATFORM="macos"
elif command -v pacman &>/dev/null; then
    PLATFORM="arch"
elif command -v apt-get &>/dev/null || command -v dpkg &>/dev/null; then
    PLATFORM="debian"
fi
[[ -n "$PLATFORM" ]] || die "$WULFUP_EXIT_PRECONDITION" "No supported package manager found (pacman, apt-get, or dpkg required)"

# Paths (Linux/Arch)
LOCK_FILE="/var/lib/pacman/db.lck"

# Paths (Debian/APT)
APT_LOCK="/var/lib/dpkg/lock-frontend"
APT_LISTS_LOCK="/var/lib/apt/lists/lock"
APT_DAILY_LOCK="/var/lib/apt/daily_lock"

# Default settings (all platforms)
RUN_OTHER_UPDATES="no"

# Linux/Arch settings
MIN_FREE_BYTES=$((1024 * 1024 * 1024))  # 1 GiB
CACHE_LIMIT=""
AUR_HELPER=""
RUN_PACDIFF="no"
RUN_SYNC="yes"
UPDATE_KEYRINGS="yes"
SKIP_PREVIEW="no"

# macOS settings
PKG_MANAGER=""
UPDATE_CASKS="yes"
UPDATE_MAS="yes"
RUN_CLEANUP="yes"
RUN_DOCTOR="no"

# Debian/APT settings
APT_MANAGER=""             # resolved by detect_package_manager_debian: nala or apt-get
NALA_MODE="auto"           # auto|yes|no - controls APT_MANAGER resolution
CLEAN_CACHE="no"
RUN_AUTOREMOVE="yes"
RUN_AUTOCLEAN="yes"
CHECK_HELD="yes"
CHECK_NEEDRESTART="yes"
CHECK_REPOS="yes"
CHECK_KERNEL="yes"
SHOW_CHANGELOG="no"
FORCE_PHASED="no"
CHECK_UBUNTU_PRO="auto"

# Supported keyrings (Linux/Arch)
KEYRINGS=(
    "archlinux-keyring"
    "cachyos-keyring"
    "chaotic-keyring"
    "endeavouros-keyring"
    "rebornos-keyring"
)

#==============================================================================
# AUR helper detection (Linux)
#==============================================================================

detect_aur_helper() {
    local helpers=(paru yay)

    for helper in "${helpers[@]}"; do
        if command -v "$helper" &>/dev/null; then
            AUR_HELPER="$helper"
            return 0
        fi
    done

    AUR_HELPER="pacman"
    return 1
}

#==============================================================================
# Settings display
#==============================================================================

print_settings() {
    info "Effective configuration:"
    if [[ "$PLATFORM" == "macos" ]]; then
        step "  Package manager: ${PKG_MANAGER:-auto-detect}"
        step "  Update casks: $UPDATE_CASKS"
        step "  Update MAS apps: $UPDATE_MAS"
        step "  Run cleanup: $RUN_CLEANUP"
        step "  Run doctor: $RUN_DOCTOR"
    elif [[ "$PLATFORM" == "debian" ]]; then
        step "  Package manager: ${APT_MANAGER:-auto-detect}"
        step "  Clean cache: $CLEAN_CACHE"
        step "  Autoremove: $RUN_AUTOREMOVE"
        step "  Autoclean: $RUN_AUTOCLEAN"
        step "  Check held packages: $CHECK_HELD"
        step "  Check needrestart: $CHECK_NEEDRESTART"
        step "  Check repositories: $CHECK_REPOS"
        step "  Check kernel: $CHECK_KERNEL"
        step "  Show changelog: $SHOW_CHANGELOG"
        step "  Force phased updates: $FORCE_PHASED"
        step "  Check Ubuntu Pro: $CHECK_UBUNTU_PRO"
        step "  Min free space: $((MIN_FREE_BYTES / 1024 / 1024)) MiB"
    else
        step "  AUR helper: $AUR_HELPER"
        step "  Update keyrings: $UPDATE_KEYRINGS"
        step "  Preview updates: $([[ "$SKIP_PREVIEW" == yes ]] && echo no || echo yes)"
        step "  Run pacdiff: $RUN_PACDIFF"
        step "  Run sync: $RUN_SYNC"
        step "  Cache limit: ${CACHE_LIMIT:-none}"
        step "  Min free space: $((MIN_FREE_BYTES / 1024 / 1024)) MiB"
        step "  Pacman --noconfirm: $PACMAN_NOCONFIRM"
    fi
    step "  Other updates: $RUN_OTHER_UPDATES"
    step "  Auto-yes (script prompts): $AUTO_YES"
    step "  Continue on error: $CONTINUE_ON_ERROR"
    step "  Desktop notification: $SEND_NOTIFICATION"
    echo
}

#==============================================================================
# Lock file handling (Linux/Arch)
#==============================================================================

check_lock_file() {
    step "Checking for pacman lock file..."

    if [[ -e "$LOCK_FILE" ]]; then
        if sudo fuser "$LOCK_FILE" &>/dev/null; then
            die "$WULFUP_EXIT_PRECONDITION" \
                "Lock file $LOCK_FILE is in use by another process." \
                "Another package manager may be running."
        else
            warn "Found stale lock file: $LOCK_FILE"
            echo -e "${BOLD}This likely means pacman was interrupted previously.${RESET}" >&2
            if confirm "Remove it? [Y/n] " yes; then
                run_sudo rm -f "$LOCK_FILE"
                success "Lock file removed"
            else
                die "$WULFUP_EXIT_ABORTED" "Cannot proceed with lock file present"
            fi
        fi
    else
        success "No lock file found"
    fi
}

#==============================================================================
# Disk space checking (Linux/Arch)
#==============================================================================

check_disk_space() {
    step "Checking disk space..."

    local available
    available=$(findmnt / -nbo avail)
    local available_mib=$((available / 1024 / 1024))
    local min_mib=$((MIN_FREE_BYTES / 1024 / 1024))

    info "Available space on /: ${available_mib} MiB"

    if [[ $available -lt $MIN_FREE_BYTES ]]; then
        warn "Low disk space! Less than ${min_mib} MiB available on root partition."

        local cache_size
        cache_size=$(du -sb /var/cache/pacman/pkg 2>/dev/null | awk '{print $1}' || echo 0)
        local cache_mib=$((cache_size / 1024 / 1024))

        if [[ $cache_size -gt $MIN_FREE_BYTES ]]; then
            echo -e "${YELLOW}Package cache is using ${cache_mib} MiB.${RESET}" >&2
            echo -e "${YELLOW}Consider cleaning it with: sudo paccache -rk1${RESET}" >&2
        fi

        if ! confirm "Continue anyway? [y/N] " no; then
            die "$WULFUP_EXIT_ABORTED" "Aborted due to low disk space"
        fi
    fi
}

#==============================================================================
# Database checking and repair (Linux/Arch)
#==============================================================================

check_databases() {
    step "Checking package databases..."

    local db_dir="/var/lib/pacman/sync"
    local corrupted_files=()
    local f

    shopt -s nullglob
    for f in "$db_dir"/*.{db,files}; do
        if ! file "$f" | grep -qE '(gzip|Zstandard|XZ) compressed data'; then
            corrupted_files+=("$f: $(file -b "$f")")
        fi
    done
    shopt -u nullglob

    if [[ ${#corrupted_files[@]} -gt 0 ]]; then
        error "Corrupted database files detected:"
        printf '  %s\n' "${corrupted_files[@]}" >&2
        return 1
    fi

    success "Package databases are healthy"
    return 0
}

clear_databases() {
    warn "This will clear all package databases!"
    if ! confirm "Are you sure? [y/N] " no; then
        info "Aborted"
        return 0
    fi

    run_sudo rm -rf /var/lib/pacman/sync
    success "Package databases cleared"
    info "Running pacman -Syy to rebuild databases..."
    # shellcheck disable=SC2046
    run_sudo pacman -Syy $(pacman_noconfirm_args)
}

#==============================================================================
# Keyring management (Linux/Arch)
#==============================================================================

get_installed_keyrings() {
    local installed_keyrings=()

    for keyring in "${KEYRINGS[@]}"; do
        if pacman -Q "$keyring" &>/dev/null; then
            installed_keyrings+=("$keyring")
        fi
    done

    printf '%s\n' "${installed_keyrings[@]}"
}

update_keyrings() {
    step "Updating keyrings first to prevent signature errors..."

    local installed_keyrings=()
    mapfile -t installed_keyrings < <(get_installed_keyrings)

    if [[ ${#installed_keyrings[@]} -eq 0 ]]; then
        warn "No recognized keyrings found installed"
        return 0
    fi

    info "Found installed keyrings: ${installed_keyrings[*]}"

    # shellcheck disable=SC2046
    if ! run_sudo pacman -Sy $(pacman_noconfirm_args) --needed "${installed_keyrings[@]}"; then
        handle_failure "Keyring update failed"
    fi

    success "Keyrings updated"
}

reset_keyrings() {
    warn "This will completely reset your keyrings!"
    warn "Your old keyring will be backed up to /root/pacman-key.bak.$(date +%Y%m%d-%H%M)"
    if ! confirm "Are you sure? [y/N] " no; then
        info "Aborted"
        return 0
    fi

    step "Backing up old keyring..."
    run_sudo mv /etc/pacman.d/gnupg "/root/pacman-key.bak.$(date +%Y%m%d-%H%M).by.$progname"

    step "Initializing new keyring..."
    run_sudo pacman-key --init

    step "Populating keyrings..."
    local populate_args=()
    local reinstall_keyrings=()

    for keyring_pkg in "${KEYRINGS[@]}"; do
        if pacman -Q "$keyring_pkg" &>/dev/null; then
            reinstall_keyrings+=("$keyring_pkg")
            populate_args+=("${keyring_pkg%-keyring}")
        fi
    done

    if [[ ${#populate_args[@]} -gt 0 ]]; then
        run_sudo pacman-key --populate "${populate_args[@]}"
    else
        warn "No installed keyrings found to populate"
    fi

    step "Syncing databases and updating keyrings..."
    if [[ ${#reinstall_keyrings[@]} -gt 0 ]]; then
        # shellcheck disable=SC2046
        if ! run_sudo pacman -Syy $(pacman_noconfirm_args) "${reinstall_keyrings[@]}"; then
            handle_failure "Some keyrings may not be available in your repositories"
        fi
    else
        warn "No installed keyring packages found to reinstall"
    fi

    step "Running full system update..."
    run_sudo pacman -Syu

    success "Keyrings have been reset"
    exit 0
}

#==============================================================================
# macOS package manager detection
#==============================================================================

detect_package_managers_macos() {
    local managers=()
    command -v brew &>/dev/null && managers+=("brew")
    command -v port &>/dev/null && managers+=("port")

    if [[ ${#managers[@]} -eq 0 ]]; then
        die "$WULFUP_EXIT_PRECONDITION" "No package manager found. Install Homebrew or MacPorts."
    fi

    printf '%s\n' "${managers[@]}"
}

#==============================================================================
# macOS Homebrew updates
#==============================================================================

update_homebrew() {
    ! command -v brew &>/dev/null && return 0

    info "Updating Homebrew..."
    echo

    step "Updating Homebrew formulae..."
    if ! run_cmd brew update; then
        handle_failure "Homebrew update"
        return
    fi
    echo

    step "Upgrading formulae..."
    if ! run_cmd brew upgrade; then
        handle_failure "Homebrew formula upgrade"
    fi
    echo

    if [[ "$UPDATE_CASKS" == "yes" ]]; then
        step "Upgrading casks..."
        if ! run_cmd brew upgrade --cask --greedy; then
            handle_failure "Homebrew cask upgrade"
        fi
        echo
    fi

    if [[ "$RUN_CLEANUP" == "yes" ]]; then
        step "Removing unused dependencies..."
        run_cmd brew autoremove
        echo

        step "Cleaning up old versions..."
        run_cmd brew cleanup
        echo
    fi

    if [[ "$RUN_DOCTOR" == "yes" ]]; then
        step "Running brew doctor..."
        if ! run_cmd brew doctor; then
            handle_failure "brew doctor"
        fi
        echo
    fi
}

#==============================================================================
# macOS MacPorts updates
#==============================================================================

update_macports() {
    ! command -v port &>/dev/null && return 0

    info "Updating MacPorts..."
    echo

    step "Syncing ports tree..."
    if ! run_sudo port selfupdate; then
        handle_failure "MacPorts selfupdate"
        return
    fi
    echo

    step "Upgrading outdated ports..."
    if ! run_sudo port upgrade outdated; then
        handle_failure "MacPorts upgrade"
    fi
    echo

    if [[ "$RUN_CLEANUP" == "yes" ]]; then
        step "Cleaning up inactive ports..."
        run_sudo port uninstall inactive || true
        echo

        step "Reclaiming disk space..."
        run_sudo port reclaim || true
        echo
    fi

    if [[ "$RUN_DOCTOR" == "yes" ]]; then
        step "Running port diagnose..."
        if ! run_cmd port diagnose; then
            handle_failure "port diagnose"
        fi
        echo
    fi
}

#==============================================================================
# macOS Mac App Store updates
#==============================================================================

update_mas() {
    [[ "$UPDATE_MAS" != "yes" ]] && return 0

    if ! command -v mas &>/dev/null; then
        info "mas not installed, skipping Mac App Store updates"
        info "Install with: brew install mas"
        return 0
    fi

    info "Updating Mac App Store apps..."
    echo

    step "Upgrading App Store apps..."
    if ! run_cmd mas upgrade; then
        handle_failure "Mac App Store upgrade"
    fi
    echo
}

#==============================================================================
# Update preview (Linux/Arch)
#==============================================================================

preview_updates() {
    if [[ "$SKIP_PREVIEW" == "yes" ]]; then
        return 0
    fi

    step "Previewing available updates..."

    if command -v checkupdates &>/dev/null; then
        local repo_updates
        repo_updates=$(checkupdates 2>/dev/null || true)
        if [[ -n "$repo_updates" ]]; then
            echo "$repo_updates" >&2
        else
            info "No official repository updates available"
        fi
    else
        warn "checkupdates not found (install pacman-contrib)"
    fi

    if [[ "$AUR_HELPER" != "pacman" ]]; then
        local aur_updates
        aur_updates=$("$AUR_HELPER" -Qua 2>/dev/null || true)
        if [[ -n "$aur_updates" ]]; then
            echo "$aur_updates" >&2
        else
            info "No AUR updates available"
        fi
    fi

    echo
    if ! confirm "Proceed with update? [Y/n] " yes; then
        die "$WULFUP_EXIT_ABORTED" "Update aborted by user"
    fi
}

#==============================================================================
# Package cache management (Linux/Arch)
#==============================================================================

clean_package_cache() {
    if [[ -z "$CACHE_LIMIT" ]]; then
        return 0
    fi

    step "Cleaning package cache (keeping last $CACHE_LIMIT versions)..."

    if ! command -v paccache &>/dev/null; then
        warn "paccache not found (install pacman-contrib)"
        return 0
    fi

    run_sudo paccache --verbose -rk"$CACHE_LIMIT"

    local cache_size
    cache_size=$(du -sh /var/cache/pacman/pkg/ 2>/dev/null | awk '{print $1}')
    info "Package cache size: $cache_size"
}

#==============================================================================
# pacdiff integration (Linux/Arch)
#==============================================================================

run_pacdiff() {
    if [[ "$RUN_PACDIFF" != "yes" ]]; then
        list_pacnew_files
        return 0
    fi

    step "Checking for .pacnew and .pacsave files..."

    if command -v pacdiff &>/dev/null; then
        run_sudo pacdiff
    else
        warn "pacdiff not found (install pacman-contrib)"
        list_pacnew_files
    fi
}

list_pacnew_files() {
    local pacnew_files=()
    local f

    while IFS= read -r f; do
        pacnew_files+=("$f")
    done < <(find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null)

    if [[ ${#pacnew_files[@]} -eq 0 ]]; then
        return 0
    fi

    warn "Found ${#pacnew_files[@]} .pacnew/.pacsave file(s):"
    printf '  %s\n' "${pacnew_files[@]}" >&2
    info "Review with: sudo pacdiff"
}

#==============================================================================
# Post-update maintenance reminders (Linux/Arch)
#==============================================================================

remind_orphans() {
    step "Checking for orphaned packages..."

    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null || true)

    if [[ -n "$orphans" ]]; then
        warn "Orphaned packages detected (not removed automatically):"
        echo "$orphans" >&2
        info "Remove with: sudo pacman -Rns \$(pacman -Qtdq)"
    else
        success "No orphaned packages found"
    fi
}

remind_kernel_rebuild() {
    local boot_epoch pkg pkg_time pkg_epoch

    boot_epoch=$(date -d "$(uptime -s)" +%s 2>/dev/null) || return 0

    while IFS= read -r pkg; do
        pkg_time=$(pacman -Qi "$pkg" 2>/dev/null | awk -F': ' '/^Install Date/ {print $2}')
        [[ -z "$pkg_time" ]] && continue
        pkg_epoch=$(date -d "$pkg_time" +%s 2>/dev/null) || continue
        if (( pkg_epoch > boot_epoch )); then
            info "Kernel package $pkg was updated since last boot."
            info "Reboot when ready. If needed: sudo mkinitcpio -P"
            return 0
        fi
    done < <(pacman -Q 2>/dev/null | awk '/^linux/ && !/-firmware|-headers|-api-headers|-tools|-docs|-man/ {print $1}')
}

#==============================================================================
# Package manager detection (Debian/APT)
#==============================================================================

detect_package_manager_debian() {
    if [[ "$NALA_MODE" == "no" ]]; then
        APT_MANAGER="apt-get"
        return 0
    fi

    if [[ "$NALA_MODE" == "yes" ]]; then
        if command -v nala &>/dev/null; then
            APT_MANAGER="nala"
        else
            die "$WULFUP_EXIT_PRECONDITION" "Nala requested but not found. Install nala or use --no-nala"
        fi
        return 0
    fi

    # Auto-detect
    if command -v nala &>/dev/null; then
        APT_MANAGER="nala"
    else
        APT_MANAGER="apt-get"
    fi
}

#==============================================================================
# Package database checking and repair (Debian/APT)
#==============================================================================

check_dpkg_database() {
    step "Checking package database integrity..."

    local audit_output
    audit_output=$(sudo dpkg --audit 2>&1 || true)

    if [[ -n "$audit_output" ]]; then
        error "Package database issues detected:"
        echo "$audit_output" >&2
        echo >&2

        if confirm "Try to fix with 'dpkg --configure -a'? [Y/n] " yes; then
            run_sudo dpkg --configure -a
            success "Database repair attempted"
        else
            warn "Continuing with database issues - updates may fail"
        fi
        return 1
    fi

    local broken_packages
    broken_packages=$(dpkg -l | grep -E '^[iufphr][^i]' || true)

    if [[ -n "$broken_packages" ]]; then
        warn "Found packages in inconsistent state:"
        echo "$broken_packages" >&2
        echo >&2
        info "Running 'dpkg --configure -a' to fix..."
        run_sudo dpkg --configure -a
    fi

    success "Package database is healthy"
    return 0
}

#==============================================================================
# Unattended upgrades detection (Debian/APT)
#==============================================================================

check_unattended_upgrades() {
    step "Checking for unattended-upgrades service..."

    if systemctl is-active --quiet unattended-upgrades.service 2>/dev/null; then
        warn "unattended-upgrades service is active"
        info "This may cause lock conflicts during manual updates"

        if confirm "Temporarily stop unattended-upgrades? [Y/n] " yes; then
            run_sudo systemctl stop unattended-upgrades.service
            info "Service stopped (will restart automatically)"
        fi
    fi

    if systemctl is-active --quiet apt-daily.service 2>/dev/null || \
       systemctl is-active --quiet apt-daily-upgrade.service 2>/dev/null; then
        warn "Automatic apt update service is running"
        info "Waiting for it to complete..."
        sleep 2
    fi
}

#==============================================================================
# Repository health checks (Debian/APT)
#==============================================================================

check_repositories() {
    if [[ "$CHECK_REPOS" != "yes" ]]; then
        return 0
    fi

    step "Checking repository health..."

    local duplicates
    duplicates=$(grep -rh "^deb " /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null | \
                 sort | uniq -d || true)

    if [[ -n "$duplicates" ]]; then
        warn "Found duplicate repository entries:"
        echo "$duplicates" | while read -r dup; do
            echo "  - $dup" >&2
        done
        echo >&2
    fi

    if [[ -f /etc/lsb-release ]] && grep -q "Ubuntu" /etc/lsb-release; then
        local ppa_files
        ppa_files=$(find /etc/apt/sources.list.d/ -name "*.list" 2>/dev/null || true)

        if [[ -n "$ppa_files" ]]; then
            local ppa_count
            ppa_count=$(echo "$ppa_files" | wc -l)
            info "Found $ppa_count PPA(s) configured"
        fi
    fi

    success "Repository check complete"
}

#==============================================================================
# Held packages (Debian/APT)
#==============================================================================

check_held_packages_debian() {
    if [[ "$CHECK_HELD" != "yes" ]]; then
        return 0
    fi

    step "Checking for held packages..."

    local held_packages
    held_packages=$(dpkg --get-selections | grep 'hold$' || true)

    if [[ -n "$held_packages" ]]; then
        warn "The following packages are held and won't be upgraded:"
        echo "$held_packages" | awk '{print "  - " $1}' >&2
        echo >&2
    else
        success "No held packages"
    fi
}

#==============================================================================
# Ubuntu Pro / ESM support (Debian/APT)
#==============================================================================

check_ubuntu_pro() {
    if [[ "$CHECK_UBUNTU_PRO" == "no" ]]; then
        return 0
    fi

    if [[ ! -f /etc/lsb-release ]] || ! grep -q "Ubuntu" /etc/lsb-release; then
        return 0
    fi

    if ! command -v pro &>/dev/null && ! command -v ubuntu-advantage-tools &>/dev/null; then
        return 0
    fi

    step "Checking Ubuntu Pro status..."

    local pro_cmd="pro"
    if ! command -v pro &>/dev/null; then
        pro_cmd="ua"
    fi

    if command -v "$pro_cmd" &>/dev/null; then
        run_cmd "$pro_cmd" status --format=tabular || true
        echo >&2
    fi
}

#==============================================================================
# Changelog viewing (Debian/APT)
#==============================================================================

show_changelogs() {
    if [[ "$SHOW_CHANGELOG" != "yes" ]]; then
        return 0
    fi

    if ! command -v apt-listchanges &>/dev/null; then
        warn "apt-listchanges not installed (apt install apt-listchanges)"
        return 0
    fi

    step "Showing recent changelogs..."
    info "This will display changelogs for recently upgraded packages"
    info "apt-listchanges will show changes during package installation"
}

#==============================================================================
# Lock file handling (Debian/APT)
#==============================================================================

check_lock_files_debian() {
    step "Checking for apt lock files..."

    local lock_files=("$APT_LOCK" "$APT_LISTS_LOCK" "$APT_DAILY_LOCK")
    local lock

    for lock in "${lock_files[@]}"; do
        if [[ -e "$lock" ]]; then
            if sudo fuser "$lock" &>/dev/null; then
                die "$WULFUP_EXIT_PRECONDITION" \
                    "Lock file $lock is in use by another process. Another package manager may be running."
            fi
        fi
    done

    success "No lock files in use"
}

#==============================================================================
# Disk space checking (Debian/APT)
#==============================================================================

check_disk_space_debian() {
    step "Checking disk space..."

    local available
    available=$(df -B1 --output=avail / | tail -1 | tr -d ' ')
    local available_mib=$((available / 1024 / 1024))
    local min_mib=$((MIN_FREE_BYTES / 1024 / 1024))

    info "Available space on /: ${available_mib} MiB"

    if [[ $available -lt $MIN_FREE_BYTES ]]; then
        warn "Low disk space! Less than ${min_mib} MiB available on root partition."

        local cache_size
        cache_size=$(du -sb /var/cache/apt/archives 2>/dev/null | awk '{print $1}' || echo 0)
        local cache_mib=$((cache_size / 1024 / 1024))

        if [[ $cache_size -gt $MIN_FREE_BYTES ]]; then
            echo -e "${YELLOW}Package cache is using ${cache_mib} MiB.${RESET}" >&2
            if [[ "$APT_MANAGER" == "nala" ]]; then
                echo -e "${YELLOW}Consider cleaning it with: sudo nala clean${RESET}" >&2
            else
                echo -e "${YELLOW}Consider cleaning it with: sudo apt-get clean${RESET}" >&2
            fi
        fi

        if ! confirm "Continue anyway? [y/N] " no; then
            die "$WULFUP_EXIT_ABORTED" "Aborted due to low disk space"
        fi
    fi
}

#==============================================================================
# Package cache and cleanup (Debian/APT)
#==============================================================================

clean_package_cache_debian() {
    if [[ "$CLEAN_CACHE" != "yes" ]]; then
        return 0
    fi

    step "Cleaning package cache..."
    if [[ "$APT_MANAGER" == "nala" ]]; then
        if ! run_sudo nala clean; then
            handle_failure "nala clean"
        fi
    else
        if ! run_sudo apt-get clean; then
            handle_failure "apt-get clean"
        fi
    fi

    local cache_size
    cache_size=$(du -hd1 /var/cache/apt/archives/ 2>/dev/null | awk '{print $1}' || echo "0")
    info "Package cache size: $cache_size"
}

autoremove_packages_debian() {
    if [[ "$RUN_AUTOREMOVE" != "yes" ]]; then
        return 0
    fi

    step "Removing unnecessary packages..."

    if [[ "$APT_MANAGER" == "nala" ]]; then
        if ! run_sudo nala autoremove -y; then
            handle_failure "nala autoremove"
        fi
    else
        if ! run_sudo apt-get autoremove -y; then
            handle_failure "apt-get autoremove"
        fi
    fi
}

autoclean_cache_debian() {
    if [[ "$RUN_AUTOCLEAN" != "yes" ]]; then
        return 0
    fi

    step "Cleaning obsolete package files..."

    if [[ "$APT_MANAGER" == "nala" ]]; then
        if ! run_sudo nala autopurge -y; then
            handle_failure "nala autopurge"
        fi
    else
        if ! run_sudo apt-get autoclean -y; then
            handle_failure "apt-get autoclean"
        fi
    fi
}

#==============================================================================
# Old configuration files (Debian/APT)
#==============================================================================

check_old_config_files_debian() {
    step "Checking for old configuration files..."

    local old_configs
    old_configs=$(find /etc -name '*.dpkg-old' -o -name '*.dpkg-dist' -o -name '*.dpkg-backup' 2>/dev/null || true)

    if [[ -n "$old_configs" ]]; then
        warn "Found old configuration files:"
        echo "$old_configs" | while read -r file; do
            echo "  - $file" >&2
        done
        echo >&2
        info "Review these files manually and remove if no longer needed"
    fi
}

#==============================================================================
# Kernel update detection (Debian/APT)
#==============================================================================

check_kernel_updates_debian() {
    if [[ "$CHECK_KERNEL" != "yes" ]]; then
        return 0
    fi

    step "Checking kernel status..."

    local running_kernel
    local installed_kernel

    running_kernel=$(uname -r)

    installed_kernel=$(dpkg -l | grep -E "^ii\s+linux-image-[0-9]" | \
                       awk '{print $2}' | sed 's/linux-image-//' | \
                       sort -V | tail -1 || echo "")

    info "Running kernel: $running_kernel"

    if [[ -n "$installed_kernel" ]]; then
        info "Latest installed: $installed_kernel"

        if [[ "$running_kernel" != "$installed_kernel" ]]; then
            warn "A newer kernel is installed but not running"
            warn "A reboot is recommended to use: $installed_kernel"
            echo >&2
        fi
    fi

    local boot_avail
    if mountpoint -q /boot 2>/dev/null; then
        boot_avail=$(df -h /boot | tail -1 | awk '{print $4}')
        info "/boot partition available space: $boot_avail"
    fi
}

#==============================================================================
# Needrestart integration (Debian/APT)
#==============================================================================

check_services_needing_restart() {
    if [[ "$CHECK_NEEDRESTART" != "yes" ]]; then
        return 0
    fi

    if ! command -v needrestart &>/dev/null; then
        info "needrestart not installed (optional: apt install needrestart)"
        return 0
    fi

    step "Checking for services that need restart..."

    if ! run_sudo needrestart -b -l; then
        handle_failure "needrestart check"
    fi
}

#==============================================================================
# Other updates (flatpak, brew extras, etc)
#==============================================================================

run_other_updates() {
    if [[ "$RUN_OTHER_UPDATES" != "yes" ]]; then
        return 0
    fi

    local other_script
    for other_script in \
        "${SCRIPT_DIR}/wulfup-other" \
        "$HOME/.local/bin/wulfup-other" \
        "/usr/local/bin/wulfup-other" \
        "/usr/bin/wulfup-other"; do
        if [[ -f "$other_script" ]]; then
            info "Running additional updates from $other_script..."
            if ! AUTO_YES="$AUTO_YES" CONTINUE_ON_ERROR="$CONTINUE_ON_ERROR" PACMAN_NOCONFIRM="$PACMAN_NOCONFIRM" bash "$other_script"; then
                handle_failure "Additional updates (wulfup-other) failed"
            fi
            return 0
        fi
    done

    info "No wulfup-other script found, skipping additional updates"
}

#==============================================================================
# Main update process - macOS
#==============================================================================

do_update_macos() {
    info "Starting system update (macOS)..."
    echo

    print_settings

    local managers=()
    if [[ -z "$PKG_MANAGER" ]]; then
        while IFS= read -r _mgr; do managers+=("$_mgr"); done < <(detect_package_managers_macos)
        info "Detected package managers: ${managers[*]}"
    else
        managers=("$PKG_MANAGER")
    fi
    echo

    for mgr in "${managers[@]}"; do
        case "$mgr" in
            brew) update_homebrew ;;
            port) update_macports ;;
            *)    warn "Unknown package manager: $mgr" ;;
        esac
    done

    update_mas
    run_other_updates

    echo
    if report_failures; then
        send_desktop_notification "System update complete" "wulfup finished updating your system"
        success "System update complete!"
    else
        die "$WULFUP_EXIT_ERROR" "System update finished with errors"
    fi
}

#==============================================================================
# Main update process - Arch Linux
#==============================================================================

do_update_arch() {
    info "Starting system update..."
    echo

    print_settings

    # Pre-update checks
    check_lock_file
    check_disk_space

    if ! check_databases; then
        warn "Database corruption detected"
        if confirm "Try to clear and rebuild databases? [Y/n] " yes; then
            clear_databases
        else
            die "$WULFUP_EXIT_PRECONDITION" "Cannot proceed with corrupted databases"
        fi
    fi

    echo

    preview_updates

    # Update keyrings first if enabled
    if [[ "$UPDATE_KEYRINGS" == "yes" ]]; then
        update_keyrings
        echo
    fi

    # Full system update
    info "Synchronizing databases and updating system packages..."
    run_sudo pacman -Syu
    echo

    # AUR updates if helper available
    if [[ "$AUR_HELPER" != "pacman" ]]; then
        info "Updating AUR packages with $AUR_HELPER..."
        run_cmd "$AUR_HELPER" -Sua
        echo
    fi

    # Post-update tasks
    clean_package_cache
    run_pacdiff
    remind_orphans
    remind_kernel_rebuild

    if [[ "$RUN_SYNC" == "yes" ]]; then
        step "Syncing filesystems..."
        run_cmd sync
    fi

    run_other_updates

    echo
    if report_failures; then
        send_desktop_notification "System update complete" "wulfup finished updating your system"
        success "System update complete!"
    else
        die "$WULFUP_EXIT_ERROR" "System update finished with errors"
    fi
}

#==============================================================================
# Main update process - Debian/APT
#==============================================================================

do_update_debian() {
    info "Starting system update using $APT_MANAGER..."
    echo

    print_settings

    # Pre-update checks
    check_unattended_upgrades
    check_lock_files_debian
    check_dpkg_database
    check_disk_space_debian
    check_repositories
    check_held_packages_debian
    check_ubuntu_pro
    echo

    if [[ "$FORCE_PHASED" == "yes" ]]; then
        info "Forcing phased updates to be included"
        export APT_CONFIG_PHASED_UPDATES="1"
    fi

    step "Updating package lists..."
    if [[ "$APT_MANAGER" == "nala" ]]; then
        run_sudo nala update
    else
        run_sudo apt-get update
    fi
    echo

    show_changelogs

    info "Upgrading packages..."
    if [[ "$APT_MANAGER" == "nala" ]]; then
        run_sudo nala upgrade -y
    elif [[ "$FORCE_PHASED" == "yes" ]]; then
        run_sudo apt-get upgrade -y -o APT::Get::Always-Include-Phased-Updates=true
    else
        run_sudo apt-get upgrade -y
    fi
    echo

    info "Running full upgrade..."
    if [[ "$APT_MANAGER" == "nala" ]]; then
        run_sudo nala upgrade --full -y
    elif [[ "$FORCE_PHASED" == "yes" ]]; then
        run_sudo apt-get full-upgrade -y -o APT::Get::Always-Include-Phased-Updates=true
    else
        run_sudo apt-get full-upgrade -y
    fi
    echo

    # Post-update tasks
    autoremove_packages_debian
    autoclean_cache_debian
    clean_package_cache_debian
    check_old_config_files_debian
    check_kernel_updates_debian
    check_services_needing_restart

    if [[ "$RUN_SYNC" == "yes" ]]; then
        step "Syncing filesystems..."
        run_cmd sync
    fi

    run_other_updates

    echo
    if report_failures; then
        send_desktop_notification "System update complete" "wulfup finished updating your system"
        success "System update complete!"
    else
        die "$WULFUP_EXIT_ERROR" "System update finished with errors"
    fi
}

do_update() {
    case "$PLATFORM" in
        macos)
            do_update_macos
            ;;
        debian)
            do_update_debian
            ;;
        *)
            do_update_arch
            ;;
    esac
}

#==============================================================================
# Usage information
#==============================================================================

usage() {
    cat << EOF
${BOLD}wulfup${RESET} - Transparent system updater for Arch Linux, Debian/Ubuntu, and macOS

${BOLD}USAGE:${RESET}
    $progname [OPTIONS]

${BOLD}OPTIONS:${RESET}
    -h, --help              Show this help message
    -v, --version           Show version information

    ${BOLD}Update Options (all platforms):${RESET}
    --other                 Run wulfup-other script for additional updates
    --yes                   Auto-answer wulfup's own prompts (not package manager's)
    --continue-on-error     Warn and continue when optional steps fail

    ${BOLD}Update Options (macOS):${RESET}
    --pkg-manager <name>    Use specific package manager (brew, port, or both)
    --no-casks              Skip Homebrew cask updates
    --no-mas                Skip Mac App Store updates
    --no-cleanup            Skip cleanup of old package versions
    --doctor                Run package manager health checks

    ${BOLD}Update Options (Linux/Arch):${RESET}
    --no-keyring            Skip keyring updates
    --no-preview            Skip checkupdates preview before updating
    --no-sync               Don't run 'sync' after update
    --sync                  Run 'sync' after update
    --no-aur                Don't update AUR packages (use only pacman)
    --helper <name>         Use specific AUR helper (yay, paru, or pacman)
    --pacdiff               Run pacdiff after update to handle .pacnew files
    --noconfirm             Pass --noconfirm to automated pacman steps (keyrings)

    ${BOLD}Maintenance Options (Linux/Arch):${RESET}
    --cache-limit <N>       Keep only N versions of each package (1-5)
    --min-free-bytes <N>    Minimum free space in bytes (default: 1 GiB)

    ${BOLD}Troubleshooting (Linux/Arch):${RESET}
    --check-databases       Check if package databases are corrupted
    --clear-databases       Clear and rebuild package databases
    --reset-keyrings        Completely reset and reinitialize keyrings

    ${BOLD}Update Options (Debian/APT):${RESET}
    --nala                  Force use of nala (error if not installed)
    --no-nala               Force use of apt-get even if nala is available
    --force-phased          Include phased updates (Ubuntu only)
    --changelog             Enable changelog viewing during upgrade
    --clean-cache           Completely clean package cache (apt-get/nala clean)
    --no-autoremove         Don't remove unnecessary packages
    --no-autoclean          Don't clean obsolete package files
    --no-held-check         Don't check for held packages

    ${BOLD}System Health Checks (Debian/APT):${RESET}
    --no-repo-check         Skip repository health checks
    --no-kernel-check       Skip kernel update detection
    --no-needrestart        Skip checking services needing restart
    --no-ubuntu-pro         Skip Ubuntu Pro status check

    ${BOLD}Notification Options (all platforms):${RESET}
    --notify                Force desktop notification when complete
    --no-notify             Disable desktop notification

${BOLD}CONFIG:${RESET}
    ~/.config/wulfup/config or /etc/wulfup.conf

${BOLD}KEYRINGS SUPPORTED (Linux/Arch):${RESET}
    - archlinux-keyring     (Arch Linux official)
    - cachyos-keyring       (CachyOS)
    - chaotic-keyring       (Chaotic-AUR)
    - endeavouros-keyring   (EndeavourOS)
    - rebornos-keyring      (RebornOS)

${BOLD}EXAMPLES:${RESET}
    # Basic system update (auto-detects platform)
    $progname

    # macOS: update only Homebrew
    $progname --pkg-manager brew

    # macOS: update with health check and additional updates
    $progname --doctor --other

    # Arch: update with AUR, clean cache, run pacdiff
    $progname --helper yay --cache-limit 2 --pacdiff

    # Arch: fix keyring issues
    $progname --reset-keyrings

    # Arch: check for database corruption
    $progname --check-databases

    # Debian/Ubuntu: update with nala and third-party packages
    $progname --nala --other

    # Debian/Ubuntu: include phased updates and view changelogs
    $progname --force-phased --changelog

    # Debian/Ubuntu: quick update, minimal checks
    $progname --no-repo-check --no-kernel-check --no-needrestart

${BOLD}NOTES:${RESET}
    - All commands are shown before execution for transparency
    - Automatically detects platform and available package managers
    - Lock files and disk space are checked before updating (Linux)
    - Keyrings are updated first to prevent signature errors (Arch)
    - Debian/APT: checks dpkg database, repositories, held packages,
      Ubuntu Pro status, and services needing restart
    - Core pacman/AUR/apt steps fail fast; use --continue-on-error for optional steps

${BOLD}EXIT CODES:${RESET}
    0  Success
    1  General error
    2  Precondition failed (lock, disk, databases)
    3  User aborted

EOF
    exit 0
}

#==============================================================================
# Argument parsing
#==============================================================================

require_arg() {
    local opt="$1"
    if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
        die "$WULFUP_EXIT_ERROR" "Option $opt requires a value"
    fi
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                ;;
            -v|--version)
                echo "$progname version $VERSION"
                exit 0
                ;;
            # Common options
            --other)
                RUN_OTHER_UPDATES="yes"
                ;;
            --yes)
                AUTO_YES="yes"
                ;;
            --continue-on-error)
                CONTINUE_ON_ERROR="yes"
                ;;
            --notify)
                SEND_NOTIFICATION="yes"
                ;;
            --no-notify)
                SEND_NOTIFICATION="no"
                ;;
            # macOS options
            --pkg-manager)
                require_arg "$1" "${2:-}"
                shift
                PKG_MANAGER="$1"
                if [[ ! "$PKG_MANAGER" =~ ^(brew|port|both)$ ]]; then
                    die "$WULFUP_EXIT_ERROR" "Invalid package manager: $PKG_MANAGER (must be brew, port, or both)"
                fi
                [[ "$PKG_MANAGER" == "both" ]] && PKG_MANAGER=""
                ;;
            --no-casks)
                UPDATE_CASKS="no"
                ;;
            --no-mas)
                UPDATE_MAS="no"
                ;;
            --no-cleanup)
                RUN_CLEANUP="no"
                ;;
            --doctor)
                RUN_DOCTOR="yes"
                ;;
            # Linux/Arch options
            --no-keyring)
                UPDATE_KEYRINGS="no"
                ;;
            --no-preview)
                SKIP_PREVIEW="yes"
                ;;
            --no-sync)
                RUN_SYNC="no"
                ;;
            --sync)
                RUN_SYNC="yes"
                ;;
            --no-aur)
                AUR_HELPER="pacman"
                ;;
            --helper)
                require_arg "$1" "${2:-}"
                shift
                AUR_HELPER="$1"
                if [[ ! "$AUR_HELPER" =~ ^(yay|paru|pacman)$ ]]; then
                    die "$WULFUP_EXIT_ERROR" "Invalid helper: $AUR_HELPER (must be yay, paru, or pacman)"
                fi
                ;;
            --pacdiff)
                RUN_PACDIFF="yes"
                ;;
            --noconfirm)
                PACMAN_NOCONFIRM="yes"
                ;;
            --cache-limit)
                require_arg "$1" "${2:-}"
                shift
                CACHE_LIMIT="$1"
                if [[ ! "$CACHE_LIMIT" =~ ^[1-5]$ ]]; then
                    die "$WULFUP_EXIT_ERROR" "Invalid cache limit: $CACHE_LIMIT (must be 1-5)"
                fi
                ;;
            --min-free-bytes)
                require_arg "$1" "${2:-}"
                shift
                MIN_FREE_BYTES="$1"
                if [[ ! "$MIN_FREE_BYTES" =~ ^[0-9]+$ ]]; then
                    die "$WULFUP_EXIT_ERROR" "Invalid min-free-bytes: $MIN_FREE_BYTES (must be a number)"
                fi
                ;;
            # Debian/APT options
            --nala)
                NALA_MODE="yes"
                ;;
            --no-nala)
                NALA_MODE="no"
                ;;
            --force-phased)
                FORCE_PHASED="yes"
                ;;
            --changelog)
                SHOW_CHANGELOG="yes"
                ;;
            --clean-cache)
                CLEAN_CACHE="yes"
                ;;
            --no-autoremove)
                RUN_AUTOREMOVE="no"
                ;;
            --no-autoclean)
                RUN_AUTOCLEAN="no"
                ;;
            --no-held-check)
                CHECK_HELD="no"
                ;;
            --no-repo-check)
                CHECK_REPOS="no"
                ;;
            --no-kernel-check)
                CHECK_KERNEL="no"
                ;;
            --no-needrestart)
                CHECK_NEEDRESTART="no"
                ;;
            --no-ubuntu-pro)
                CHECK_UBUNTU_PRO="no"
                ;;
            --check-databases)
                if check_databases; then
                    success "Databases are OK"
                    exit 0
                else
                    error "Databases are corrupted"
                    exit "$WULFUP_EXIT_PRECONDITION"
                fi
                ;;
            --clear-databases)
                clear_databases
                exit 0
                ;;
            --reset-keyrings)
                reset_keyrings
                exit 0
                ;;
            *)
                die "$WULFUP_EXIT_ERROR" "Unknown option: $1\nUse --help for usage information"
                ;;
        esac
        shift
    done
}

#==============================================================================
# Main entry point
#==============================================================================

main() {
    # Check if running as root
    if [[ $EUID -eq 0 ]]; then
        die "$WULFUP_EXIT_ERROR" "Do not run this script as root. It will use sudo when needed."
    fi

    # Check if sudo is available
    if ! command -v sudo &>/dev/null; then
        die "$WULFUP_EXIT_ERROR" "sudo is required but not found"
    fi

    load_config
    parse_args "$@"

    # Auto-detect AUR helper on Arch if not specified
    if [[ "$PLATFORM" == "arch" && -z "$AUR_HELPER" ]]; then
        if detect_aur_helper; then
            info "Detected AUR helper: $AUR_HELPER"
        else
            info "No AUR helper found, using pacman only"
        fi
    fi

    # Auto-detect apt/nala on Debian if not specified
    if [[ "$PLATFORM" == "debian" && -z "$APT_MANAGER" ]]; then
        detect_package_manager_debian
        info "Using package manager: $APT_MANAGER"
    fi

    # Run the update
    do_update
}

main "$@"
